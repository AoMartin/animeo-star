# Copy to .env locally. Never commit machine-specific values.
GODOT_EXECUTABLE_PATH=<path-to-godot-4.7-executable>
BLENDER_EXECUTABLE_PATH=<path-to-blender-executable>
PYTHON_EXECUTABLE_PATH=<path-to-python-executable>
STAR_MODEL_PATH=<path-to-neutral-star-model>
FFMPEG_EXECUTABLE_PATH=<path-to-ffmpeg-executable>
EXPORT_PATH=<local-export-directory>
TEMP_PROCESSING_PATH=<local-processing-directory>

